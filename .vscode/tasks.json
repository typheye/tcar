{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "运行",
            "type": "shell",
            "icon": {
                "id": "play",
                "tooltip": "上传并重启远程服务"
            },
            "command": "${workspaceFolder}\\scripts\\with-raspi4b.bat",
            "args": [
                "--reset"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "日志",
            "type": "shell",
            "icon": {
                "id": "output",
                "tooltip": "查看 turbopi.service 实时日志"
            },
            "command": "${workspaceFolder}\\scripts\\with-raspi4b.bat",
            "args": [
                "--log"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "SSH",
            "type": "shell",
            "icon": {
                "id": "terminal",
                "tooltip": "打开 SSH 连接到树莓派"
            },
            "command": "${workspaceFolder}\\scripts\\with-raspi4b.bat",
            "args": [
                "--ssh"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "重启",
            "type": "shell",
            "icon": {
                "id": "refresh",
                "tooltip": "重启树莓派"
            },
            "command": "${workspaceFolder}\\scripts\\with-raspi4b.bat",
            "args": [
                "--reboot"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "格式化",
            "type": "shell",
            "icon": {
                "id": "trash",
                "tooltip": "删除树莓派 ~/TurboPi 目录"
            },
            "command": "${workspaceFolder}\\scripts\\with-raspi4b.bat",
            "args": [
                "--format"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}