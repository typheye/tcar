menu "Typheye Car Server"

config TCAR_LED_GPIO
    int "Status LED GPIO"
    default 21
    help
        Seeed Studio XIAO ESP32S3 USER_LED is GPIO21.

config TCAR_LED_ACTIVE_LOW
    bool "Status LED is active low"
    default y
    help
        XIAO user LED is driven as active-low on common board revisions.

endmenu